ABB_BRIDGE_API_HOST=127.0.0.1
ABB_BRIDGE_API_PORT=8000
ABB_BRIDGE_API_KEY=replace-this-before-sharing
ABB_BRIDGE_TCP_HOST=127.0.0.1
ABB_BRIDGE_TCP_PORT=9100
ABB_BRIDGE_START_TCP_GATEWAY=true
ABB_BRIDGE_CONTROLLER_MODE=mock

# RWS mode only. Prefer the controller's HTTPS address on RW7/RW8.
ABB_BRIDGE_RWS_BASE_URL=https://192.0.2.10
ABB_BRIDGE_RWS_USERNAME=Default User
ABB_BRIDGE_RWS_PASSWORD=robotics
ABB_BRIDGE_RWS_API_VERSION=2
ABB_BRIDGE_RWS_VERIFY_TLS=true
ABB_BRIDGE_RWS_ALLOW_WRITES=false

