# Build artifacts
*.exe
*.obj
*.pdb
*.ilk

# CMake / build output
**/build/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile

# Visual Studio / MSBuild
**/.vs/
**/*.sln
**/*.slnx
**/*.vcxproj
**/*.vcxproj.filters
**/*.vcxproj.user
**/*.VC.db
**/*.VC.opendb
**/*.tlog
**/*.recipe
**/*.lastbuildstate

# TurtleBot / ROS2 runtime artifacts
Ros2/turtlebot_server/data/log/
Ros2/turtlebot_server/backup/
Ros2/turtlebot_server/**/__pycache__/
Ros2/turtlebot_server/**/*.pyc

# Python bytecode cache
**/__pycache__/
**/*.pyc

# Python virtual environments
**/.venv/

# Pytest cache
**/.pytest_cache/

# Office lock/temp files (created while a .pptx/.docx is open)
**/~$*

# Scratch/temporary working files (PDF/PPT extraction drafts, etc.)
tmp/

# Claude Code local project state (personal, machine-specific - not shared)
.claude/
