{
    "git.useEditorAsCommitInput": true,
    "terminal.external.windowsExec": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
    "files.exclude": {
        "**/*.exe": true,
        "**/*.obj": true,
        "**/*.pdb": true,
        "**/*.ilk": true
    },
    "search.exclude": {
        "**/*.exe": true,
        "**/*.obj": true,
        "**/*.pdb": true,
        "**/*.ilk": true
    },
    "cmake.sourceDirectory": "C:/dev/Study/CPP/Project_Kiosk",
    "python.defaultInterpreterPath": "C:\\dev\\Study\\OpenCV\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,

    "abb-rapid-pack.enableErrorHighlights": true,
    "abb-rapid-pack.enableRapidFormatter": false,
    "abb-rapid-pack.enableCrossFileGlobalSymbolDuplicateErrors": false,

    "[rapid]": {
        "editor.tabCompletion": "on",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": false
